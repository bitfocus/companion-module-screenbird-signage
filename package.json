{
	"name": "screenbird-signage",
	"version": "1.0.0",
	"description": "Bitfocus Companion module for Screenbird digital signage",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "bash test/run-all.sh",
		"lint:raw": "eslint",
		"lint": "run lint:raw ."
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-screenbird-signage.git"
	},
	"engines": {
		"node": "^22.20",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~2.0.4"
	},
	"devDependencies": {
		"@companion-module/tools": "~3.1.1",
		"@types/node": "^22.18.0",
		"eslint": "10.13.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "3.9.10",
		"rimraf": "^6.0.1",
		"typescript": "~5.9.3",
		"typescript-eslint": "8.71.2"
	},
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.18.1"
}
